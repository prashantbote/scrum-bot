<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{{ title }}</title></head>
<body style="margin:0;background:#f4f6f8;font:14px/20px Inter,'Segoe UI',system-ui,-apple-system,sans-serif;color:#1f2933">
<div style="max-width:640px;margin:0 auto;padding:24px 16px">
  <div style="font-size:12px;color:#5f6b7a">Scrum Bot · {{ kicker }}</div>
  {% block body %}{% endblock %}
  <div style="margin-top:20px;font-size:12px;color:#5f6b7a">{% block footer %}Sent by Scrum Bot. Every line links back to the transcript in the app.{% endblock %}</div>
</div>
</body>
</html>
