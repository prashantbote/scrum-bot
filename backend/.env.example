# Copy to .env. Every variable is prefixed SCRUM_ (see packages/core/scrum_core/settings.py).
SCRUM_ENV=dev

# Data (infra/docker-compose.yml). The app role has no BYPASSRLS; migrations run as the owner.
SCRUM_DATABASE_URL=postgresql+asyncpg://scrum_app:scrum_app@localhost:55432/scrum
SCRUM_DATABASE_OWNER_URL=postgresql+asyncpg://scrum:scrum@localhost:55432/scrum
SCRUM_REDIS_URL=redis://localhost:6379/0
SCRUM_TEMPORAL_ADDRESS=localhost:7233

# Auth: "dev" trusts X-Mock-User (frontend NEXT_PUBLIC_APP_MODE=api). "oidc" for Keycloak/Entra/Authentik.
SCRUM_AUTH_MODE=dev
# SCRUM_OIDC_ISSUER=http://localhost:8180/realms/scrum-bot
# SCRUM_OIDC_AUDIENCE=scrum-bot-api
SCRUM_CORS_ORIGINS=["http://localhost:3000"]
SCRUM_PUBLIC_APP_URL=http://localhost:3000
SCRUM_PUBLIC_API_URL=http://localhost:8800/api/v1

# Secrets — required in prod (generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
# SCRUM_ACTION_TOKEN_SECRET=
# SCRUM_KEK_BASE64=

# Open-source LLM: any OpenAI-compatible server (Ollama, vLLM, llama.cpp, LocalAI). "heuristic" = no model.
SCRUM_LLM_PROVIDER=openai_compat
SCRUM_LLM_BASE_URL=http://localhost:11434/v1
SCRUM_LLM_FAST_MODEL=llama3.2:3b
SCRUM_LLM_STRONG_MODEL=qwen2.5:7b-instruct-q4_K_M
SCRUM_EMBED_PROVIDER=openai_compat
SCRUM_EMBED_MODEL=nomic-embed-text

# Voice: fake (scripted demo calls) or the open-source stack (uv sync --extra voice; make voices).
SCRUM_MEETING_PROVIDER=fake          # livekit
SCRUM_STT_PROVIDER=fake              # whisper
SCRUM_TTS_PROVIDER=fake              # piper
SCRUM_LIVEKIT_URL=ws://localhost:7880
SCRUM_LIVEKIT_API_KEY=devkey
SCRUM_LIVEKIT_API_SECRET=secret
SCRUM_MEETING_JOIN_URL_TEMPLATE=http://localhost:3001/rooms/{room}

# PM tool: fake (demo catalog) or jira (OAuth 3LO app).
SCRUM_PM_PROVIDER=fake
# SCRUM_JIRA_CLIENT_ID=
# SCRUM_JIRA_CLIENT_SECRET=

# Mail: SMTP (Mailpit locally: UI on http://localhost:8025).
SCRUM_MAIL_PROVIDER=smtp
SCRUM_SMTP_HOST=localhost
SCRUM_SMTP_PORT=1025
SCRUM_MAIL_FROM=Scrum Bot <standup-bot@scrumbot.local>

# Blobs: local disk or any S3 API (SeaweedFS on :8333 in compose).
SCRUM_BLOB_BACKEND=local
