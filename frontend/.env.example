# API base URL. In mock mode MSW intercepts requests to this path in the browser.
NEXT_PUBLIC_API_URL=/api/v1

# "mock" (default): MSW-backed API + persona picker sign-in, no backend or Entra needed.
# "api":  real backend (backend: SCRUM_AUTH_MODE=dev, `make seed`) + the same persona picker.
#         Set NEXT_PUBLIC_API_URL=http://localhost:8800/api/v1
# "live": real backend + OIDC bearer tokens (Microsoft Entra ID via MSAL).
NEXT_PUBLIC_APP_MODE=mock

# Required when NEXT_PUBLIC_APP_MODE=live
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations
NEXT_PUBLIC_ENTRA_API_SCOPE=api://scrum-bot/access_as_user
